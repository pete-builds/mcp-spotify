# Spotify Developer app credentials (from https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Refresh token from running bootstrap.py locally
SPOTIFY_REFRESH_TOKEN=

# Bearer token for the HTTP transport. REQUIRED: the server refuses to start
# over HTTP without it, and every client must then send it as
#   Authorization: Bearer <token>
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# It belongs in this .env on the host and nowhere else. Run `chmod 600 .env`.
# Never put it in docker-compose.yml and never commit it.
MCP_AUTH_TOKEN=

# Optional: override default port (3703) or host
# MCP_HOST=0.0.0.0
# MCP_PORT=3703
